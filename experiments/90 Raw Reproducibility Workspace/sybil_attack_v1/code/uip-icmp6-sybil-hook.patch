@@
 /** \brief temporary IP address */
 static uip_ipaddr_t tmp_ipaddr;
 
+/* Dissertation Sybil hook. Default is OFF unless an experiment app overrides it. */
+int sybil_attack_enabled __attribute__((weak)) = 0;
+static uint16_t sybil_identity_counter;
+
 LIST(echo_reply_callback_list);
@@
   memcpy(&UIP_IP_BUF->destipaddr, dest, sizeof(*dest));
   uip_ds6_select_src(&UIP_IP_BUF->srcipaddr, &UIP_IP_BUF->destipaddr);
+  if(sybil_attack_enabled && type == ICMP6_RPL && code == 1) {
